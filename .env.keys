# ═══════════════════════════════════════════════════════════════════
#  Jarvis configuration — copy this file to .env and fill it in.
#     cp .env.keys .env
#
#  Only ONE thing here is truly required: OPENAI_API_KEY (Groq).
#  Everything else has a free, no-signup fallback.
# ═══════════════════════════════════════════════════════════════════


# ─── LLM + speech to text (REQUIRED) ───────────────────────────────────
# Get a free key at https://console.groq.com/keys — no credit card.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo


# ─── Wake word ──────────────────────────────────────────────────────────
# auto | openwakeword | porcupine
#
#   openwakeword  Fully local. No key, no signup, no corporate email.
#                 Ships a pretrained "hey jarvis" model.   ← recommended
#   porcupine     Picovoice. Needs an AccessKey; their signup form
#                 asks for a corporate email.
#
# `auto` uses Porcupine if PORCUPINE_ACCESS_KEY is set, otherwise openWakeWord.
WAKE_ENGINE=auto
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.5

# Only needed for WAKE_ENGINE=porcupine
# Get one at https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=
# Optional: path to a custom .ppn keyword file
# PORCUPINE_KEYWORD_PATH=./jarvis_wake.ppn


# ─── Text to speech ─────────────────────────────────────────────────────
# auto | edge | google | sapi
#
#   edge    Microsoft Edge TTS. No key, no signup, no billing, and it
#           sounds like a real person. Needs internet.      ← recommended
#   google  Google Cloud TTS. Requires a billing account.
#   sapi    Windows built-in voice. Fully offline, robotic, zero setup.
TTS_ENGINE=auto

# Voice for the edge engine. en-US-GuyNeural is male; try en-US-AriaNeural
# or en-GB-SoniaNeural for alternatives.
TTS_VOICE_EDGE=en-US-GuyNeural

# Only needed for TTS_ENGINE=google
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
TTS_VOICE_NAME=en-US-Standard-A


# ─── OCR ────────────────────────────────────────────────────────────────
# auto | openrouter | ocrspace | tesseract | google
#
#   openrouter  Free vision LLM. Best on handwriting. Needs a free
#               OpenRouter account (Google sign-in, no credit card).
#   ocrspace    OCR.space free API. 25,000 requests/month, no card.
#               Uses the public demo key unless you set one below.
#   tesseract  Fully local. No key at all, but poor on handwriting.
#               Great for printed text.
#   google      Google Cloud Vision. Requires a billing account.
OCR_ENGINE=auto

# Free OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Free OCR.space key: https://ocr.space/ocrapi
# Leave blank to use the public "helloworld" demo key.
OCRSPACE_API_KEY=


# ─── Microphone ────────────────────────────────────────────────────────
# Which input device to record from. Empty = system default.
# Set to a device index ("2") or part of a device name ("headset", "usb mic").
# List your devices with:  python mic_manager.py --list-devices
MIC_DEVICE=


# ─── Feature flags ──────────────────────────────────────────────────────
MEMORY_ENABLED=True
MEMORY_MAX_TURNS=10
DOCS_OUTPUT_DIR=./documents
OCR_TEMP_DIR=./scans
SCREENSHOTS_DIR=./screenshots
